# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
{
	# Agencies' own domains: a certificate is issued on the first visit,
	# only for domains the app confirms belong to an agency.
	on_demand_tls {
		ask http://app:3000/.well-known/tls-check
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Any other domain pointed here (an agency's CNAME).
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}

http:// {
	redir https://{host}{uri} permanent
}
