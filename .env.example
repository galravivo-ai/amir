# Public address of the site (used in QR codes, emails and links)
PUBLIC_URL=https://reviews.example.com
PORT=3000

# Security (production behind HTTPS)
SECURE_COOKIES=true
TRUST_PROXY=1
# After creating your own account, set to false to close public signup
ALLOW_SIGNUP=true
# Extra system admins (comma separated). The first account is always one.
SUPERADMIN_EMAILS=

# Email (without it, emails are only recorded in /superadmin)
# Example for Gmail with an app password: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=ביקורות <no-reply@example.com>

# AI (reply drafts + insights). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Backups
BACKUP_DIR=data/backups
BACKUP_KEEP=14
